{
  "manifest_version": 3,
  "name": "熊猫下载器",
  "description": "用熊猫下载器接管浏览器下载、嗅探网页视频：多连接加速、断点续传、音视频自动合并。",
  "version": "0.3.3",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "熊猫下载器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "downloads",
    "downloads.ui",
    "nativeMessaging",
    "contextMenus",
    "cookies",
    "storage",
    "webRequest",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "run_at": "document_idle",
      "js": [
        "content.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "matches": [
        "https://*.douyin.com/*",
        "https://*.kuaishou.com/*",
        "https://*.gifshow.com/*",
        "https://*.ixigua.com/*",
        "https://*.xiaohongshu.com/*",
        "https://*.weibo.com/*",
        "https://*.weibo.cn/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.facebook.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://*.zhihu.com/*",
        "https://haokan.baidu.com/*",
        "https://*.vimeo.com/*"
      ],
      "js": [
        "site_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/32.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}